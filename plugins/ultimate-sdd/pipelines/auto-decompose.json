{
  "version": 1,
  "name": "auto-decompose",
  "description": "Split large work into scoped child CHANGEs, then proportionate design, per-task TDD, fresh verification and ordered review through small-feature.",
  "stages": [
    {"id": "decompose", "kind": "decompose", "skill": "plan-decompose", "role": "planner", "requires": [], "gate": false, "childPipeline": "small-feature"},
    {"id": "propose", "skill": "plan-propose", "role": "planner", "requires": ["decompose"], "gate": true},
    {"id": "apply", "skill": "plan-apply", "role": "implementer", "requires": ["propose"], "gate": true},
    {"id": "verify", "skill": "task-verify", "role": "reviewer", "requires": ["apply"]},
    {"id": "review-loop", "skill": "plan-review", "role": "fixer", "requires": ["verify"], "loop": {"kind": "review-cycle", "maxRounds": 3}},
    {"id": "archive", "skill": "plan-archive", "role": "shipper", "requires": ["review-loop"]}
  ]
}
