{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "avr-debug PostToolUse pre-flight cue hook (behavioral cue, not a gate)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/avr-debug-preflight-cue.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/avr-debug-preflight-cue.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
